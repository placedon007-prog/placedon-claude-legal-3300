# Confirmed public HTTPS origin. Blank means no canonical/schema URLs and no indexing.
SITE_ORIGIN=
SITE_PUBLICATION_READY=false

# Closed by default. Requires all settings below plus complete legal-template details.
WAITLIST_ENABLED=false
WAITLIST_SINK_URL=
WAITLIST_SINK_TOKEN=
# Sink must honour Idempotency-Key and return {"stored":true,"requestId":"same UUID"}.
PRIVACY_NOTICE_VERSION=
CONSENT_VERSION=
LEGAL_REVIEW_CONFIRMED=false
# JSON mapping every {{TOKEN}} in src/lib/placedon-content/legal to reviewed public details.
# Contains only public policy facts, never credentials. Keep real configuration out of Git.
LEGAL_DETAILS_JSON={}

# Optional confirmation hook. No email is sent without an explicit configured endpoint.
CONFIRMATION_HOOK_URL=
CONFIRMATION_HOOK_TOKEN=

# Placedon legal engine (src/lib/engine). Read server-side only — NEVER prefix
# these NEXT_PUBLIC_*, which would inline them into client JavaScript.
# Blank PLACEDON_API_ORIGIN => the Mock engine (fixtures), so the app runs with
# no backend. Set it to switch to the live engine — that is the only change
# needed to go live. HTTPS required, except plain HTTP on loopback for local dev
# (the engine binds 127.0.0.1:8020). Token is optional Bearer auth.
PLACEDON_API_ORIGIN=
PLACEDON_API_TOKEN=
# No analytics provider is bundled or enabled. Do not add tracking before consent.
